GEMINI_API_KEY=
# 1 = use fixture instead of calling Gemini (default; set 0 for real calls)
MOCK_LLM=1

# --- analysis tuning (Person 2) ---
# Gemini model; compare candidates with: python eval/run.py --models a,b
GEMINI_MODEL=gemini-2.5-flash
# 1 = second Gemini pass that double-checks every detection on crops
ANALYSIS_VERIFY=1
# Tiled analysis for large images (one full pass + GRID x GRID overlapping tiles)
ANALYSIS_TILING=1
ANALYSIS_TILE_MIN_SIDE=2000
ANALYSIS_TILE_GRID=4
# Cache Gemini answers on disk (backend/app/analysis/.cache) to save quota during the demo
ANALYSIS_CACHE=1
