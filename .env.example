GEMINI_API_KEY=
# 1 = use fixture instead of calling Gemini (default; set 0 for real calls)
MOCK_LLM=1

# --- analysis tuning (Person 2) ---
# Gemini model; compare candidates with: python eval/run.py --models a,b
GEMINI_MODEL=gemini-3.5-flash-lite
# Gemini 3 reasoning depth: minimal (default, fastest; recommended for detection) | low | medium | high
GEMINI_THINKING_LEVEL=minimal
# 1 = second Gemini pass that double-checks every detection on crops
ANALYSIS_VERIFY=1
# Tiled analysis for large images (one full pass + GRID x GRID overlapping tiles)
ANALYSIS_TILING=1
ANALYSIS_TILE_MIN_SIDE=2000
ANALYSIS_TILE_GRID=4
# Cache Gemini answers on disk (backend/app/analysis/.cache) to save quota during the demo
ANALYSIS_CACHE=1

# --- AI toggle (also switchable at runtime from the review dashboard) ---
# 1 = Gemini analyzes curated frame pairs (deep analysis); 0 = stop after the CV diff (heatmap regions only)
AI_ENABLED=1

# --- automatic batching (also switchable at runtime from the review dashboard) ---
# 1 = settled inbox files are batched per project at once; 0 = they wait in the inbox and the worker is paused
AUTO_BATCH=1

# --- watch-folder batch pipeline ---
# 1 = the API watches WATCH_DIR and processes name-paired media (<key>_<Before|After|DayN>, e.g. Site_A_Day1.mp4)
WATCH_ENABLED=1
# Default: <repo>/input
WATCH_DIR=
# Video frames per second to extract (0.5 = one frame every 2 s) and their maximum long side in pixels
FRAME_FPS=0.5
FRAME_MAX_SIDE=1920
# Curated frame pairs kept per batch (also caps Gemini calls: at most 2 per pair)
MATCH_MAX_PAIRS=20
# What Gemini looks for in batch frame pairs (default: any real physical change)
BATCH_CRITERIA=
# FFmpeg binary; empty = ffmpeg on PATH, else the one bundled with the imageio-ffmpeg package
FFMPEG_BIN=
